# Backend settings (all optional; defaults live in backend/app/config.py).
# Copy to backend/.env for local overrides. Never put real secrets in this file.
# BigQuery login comes from gcloud Application Default Credentials, not from this file.

APP_GCP_PROJECT_ID=ellabache-singleview
APP_BIGQUERY_LOCATION=australia-southeast1
APP_MAX_BYTES_BILLED=5368709120
APP_QUERY_TIMEOUT_SECONDS=60
APP_CACHE_TTL_RECENT_SECONDS=600
APP_CACHE_TTL_CLOSED_SECONDS=43200
APP_CACHE_TTL_REFERENCE_SECONDS=86400
APP_BUSINESS_TIMEZONE=Australia/Sydney
APP_MAX_RANGE_DAYS=366
# APP_FRONTEND_DIST_DIR=/app/frontend/dist
